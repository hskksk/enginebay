{
  "name": "enginebay",
  "version": "1.2.0",
  "license": "UNLICENSED",
  "description": "Isolated bays for coding-agent CLIs (OpenCode, Claude Code, Cursor Agent, and later engines).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "enginebay": "./dist/cli-main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hskksk/enginebay.git"
  },
  "bugs": {
    "url": "https://github.com/hskksk/enginebay/issues"
  },
  "homepage": "https://github.com/hskksk/enginebay#readme",
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@types/node": "^22.0.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
